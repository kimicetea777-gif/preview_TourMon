/scripts/map-pipeline/bin
/scripts/map-pipeline/data

# cloudflare-worker (1단계 배경 지도 — 타일 서빙) — wrangler 로컬 캐시/상태
cloudflare-worker/**/.wrangler
cloudflare-worker/**/.dev.vars

