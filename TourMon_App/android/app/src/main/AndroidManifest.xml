<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1단계 배경 지도 — 지도 타일 로딩 + 실시간 위치 표시. 거리 측정 이중화(Document/temp.md)
         의 주 경로(GPS 포그라운드 거리 측정)와 mock-location 감지도 이 위치 권한을 그대로 재사용
         — 별도 위치 권한 추가 없음. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- 거리 측정 이중화(Document/temp.md)의 보조 경로 — raw 걸음 센서(TYPE_STEP_COUNTER,
         pedometer 패키지)를 읽어 "앱이 꺼져 있던 동안의 이동"을 보충. Android 10(API 29)+는
         이 걸음 센서 접근에 런타임 권한이 필요하며, JIT로 파트너 알을 처음 지정하는 시점에
         요청함(permission_handler). Health Connect 관련 권한/인텐트/alias는 전량 제거됨(삼성
         헬스↔Health Connect 동기화 불안정 회피). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>

    <application
        android:label="TourMon"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <!-- allowBackup="false"(2026-09-14) — 기본값(true)이면 Android 자동 백업이 게임 데이터
             전체(sqflite DB 하나에 알/몬스터/거리/웰컴알 지급 플래그까지 다 들어있음, app_settings_repository.dart
             참고)를 구글 드라이브에 백업했다가, 같은 구글 계정 기기에서 삭제 후 재설치 시 조용히
             복원해버림 — "삭제하면 완전 초기화"라는 사용자 기대와 어긋나고, 웰컴 알 재설치 파밍
             허용 설계(Document/temp.md "앱 설치 웰컴 알")도 의도치 않게 막힘. 트레이드오프: 기기
             변경/재설치 시 정상 유저도 로컬 데이터를 복구할 방법이 없어짐(서버 백업이 없는 게스트
             전용 출시라 지금은 이 트레이드오프가 더 유리하다고 판단) -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 6단계 — flutter_web_auth_2 로그인/로그아웃 콜백 수신용. flutter_appauth 시절의
             manifestPlaceholders["appAuthRedirectScheme"] 방식과 달리, 패키지가 요구하는 별도
             CallbackActivity를 직접 등록해야 함(pub.dev 문서 확인, Document/temp.md Phase E 참고).
             android:exported="true"는 Android 12(API 31)+ 필수, android:taskAffinity=""는
             패키지 5.0.0+ 필수. scheme은 AS `application.yml`의 redirect-uri,
             lib/config/auth_config.dart의 redirectScheme과 정확히 일치해야 함. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.tourmon.app"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher(마이페이지 "계정 관리로 이동")가 외부 브라우저를 찾을 수 있도록 —
             Android 11+ 패키지 가시성 제한 때문에 명시 안 하면 launchUrl이 브라우저를 못 찾을 수 있음. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>
