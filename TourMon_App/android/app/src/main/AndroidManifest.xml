<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1단계 배경 지도 — 지도 타일 로딩 + 실시간 위치 표시. 4단계 부화의 mock-location 감지
         (Document/temp.md "통합 결정")도 이 권한을 그대로 재사용 — 별도 위치 권한 추가 없음. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- 4단계 부화 — Health Connect 걸음수 조회(Health Connect 전환, Document/temp.md "통합 결정").
         READ_DISTANCE 대신 READ_STEPS — 삼성 헬스가 Health Connect에 STEPS만 동기화하고
         DISTANCE_DELTA는 안 써서(실기기 확인, 2026-08-26) STEPS를 조회해 앱에서 직접 거리로
         환산(GameConfig.stepsToMetersFactor). READ 전용(WRITE 없음) — 이 앱은 걸음수를 기록하지
         않고 조회만 함. -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <!-- READ_HEALTH_DATA_IN_BACKGROUND(백그라운드 STEPS 읽기, Android 15+에만 존재)는 의도적으로
         선언하지 않음 — Health Connect 심사 리스크가 가장 큰 권한인데, 없어도 백그라운드 동기화가
         RemoteException으로 실패할 뿐 데이터 유실은 없음(포그라운드 복귀 시 DistanceTrackerService.
         syncNow가 [마지막 반영, now) 하루 전체를 재조회해 따라잡음, self-healing). Android 14
         이하는 이 권한 자체가 없어 이미 이렇게 동작했고 15+도 통일(2026-08-29 결정,
         Document/study_folder/4-1_Health Connect 전환.md). -->

    <application
        android:label="TourMon"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Health Connect가 "왜 이 앱이 건강 데이터를 요청하는지" 설명 화면을 보여줄 때
                 진입하는 인텐트(health 패키지 예제 매니페스트 그대로 반영, 2026-08-19 확인). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Android 14(API 34)+에서 Health Connect 권한 사용 내역 화면("이 앱이 언제 내 건강
             데이터를 봤는지")이 요구하는 필수 alias — health 패키지 예제 매니페스트 그대로 반영. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <!-- 6단계 — flutter_web_auth_2 로그인/로그아웃 콜백 수신용. flutter_appauth 시절의
             manifestPlaceholders["appAuthRedirectScheme"] 방식과 달리, 패키지가 요구하는 별도
             CallbackActivity를 직접 등록해야 함(pub.dev 문서 확인, Document/temp.md Phase E 참고).
             android:exported="true"는 Android 12(API 31)+ 필수, android:taskAffinity=""는
             패키지 5.0.0+ 필수. scheme은 AS `application.yml`의 redirect-uri,
             lib/config/auth_config.dart의 redirectScheme과 정확히 일치해야 함. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.tourmon.app"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher(마이페이지 "계정 관리로 이동")가 외부 브라우저를 찾을 수 있도록 —
             Android 11+ 패키지 가시성 제한 때문에 명시 안 하면 launchUrl이 브라우저를 못 찾을 수 있음. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="http"/>
        </intent>
        <!-- Health Connect 설치 여부 확인/설치 유도(health 패키지의 isHealthConnectAvailable/
             installHealthConnect가 필요로 함) + 권한 설명 화면 인텐트 — health 패키지 예제
             매니페스트 그대로 반영. -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
</manifest>
